------------------------------------------------------------
-- Character Helpers
------------------------------------------------------------
local function getChar()
	return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHum()
	return getChar():FindFirstChildOfClass("Humanoid")
end

local function getHRP()
	return getChar():WaitForChild("HumanoidRootPart")
end

------------------------------------------------------------
-- =========================
-- AUTO FARM SYSTEM
-- =========================
------------------------------------------------------------

local RocksFolder = workspace:WaitForChild("Rocks"):WaitForChild("Island3RedCave")

local Knit = ReplicatedStorage:WaitForChild("Shared")
	:WaitForChild("Packages"):WaitForChild("Knit")
	:WaitForChild("Services")

local InventoryEvent = Knit.InventoryService.RE.Event
local ToolActivatedRF = Knit.ToolService.RF.ToolActivated

local AutoFarm = false
local MoveSpeed = 120
local LandOffset = 1.5
local SwingDelay = 0.25
local MineTimeout = 10

local activeTween, cfValue, applyConn, holdConn, noclipConn

------------------------------------------------------------
-- Utility
------------------------------------------------------------
local function setNoclip(state)
	if state then
		if noclipConn then noclipConn:Disconnect() end
		noclipConn = RunService.Stepped:Connect(function()
			for _, p in ipairs(getChar():GetDescendants()) do
				if p:IsA("BasePart") then
					p.CanCollide = false
				end
			end
		end)
	else
		if noclipConn then noclipConn:Disconnect() noclipConn = nil end
	end
end

local function stopAllMotion()
	if applyConn then applyConn:Disconnect() applyConn = nil end
	if activeTween then pcall(function() activeTween:Cancel() end) activeTween = nil end
	if cfValue then cfValue:Destroy() cfValue = nil end
	if holdConn then holdConn:Disconnect() holdConn = nil end

	local hrp = getHRP()
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
end

------------------------------------------------------------
-- Movement
------------------------------------------------------------
local function moveTo(pos)
	local hrp = getHRP()
	stopAllMotion()

	cfValue = Instance.new("CFrameValue")
	cfValue.Value = hrp.CFrame

	applyConn = RunService.Heartbeat:Connect(function()
		hrp.CFrame = cfValue.Value
	end)

	local dist = (hrp.Position - pos).Magnitude
	local time = math.clamp(dist / MoveSpeed, 0.1, 10)

	activeTween = TweenService:Create(
		cfValue,
		TweenInfo.new(time, Enum.EasingStyle.Linear),
		{Value = CFrame.new(pos)}
	)

	activeTween:Play()
	activeTween.Completed:Wait()

	stopAllMotion()
end

------------------------------------------------------------
-- Mining
------------------------------------------------------------
local function equipPickaxe()
	InventoryEvent:FireServer({
		"Pickaxe",
		"Weapon",
		"",
		"",
		"",
		"",
		"",
		"",
		"",
		"",
		"",
		"Inventory"
	})
end

local function mineOnce()
	ToolActivatedRF:InvokeServer("Pickaxe")
end

local function holdPosition()
	local hrp = getHRP()
	local lock = hrp.CFrame
	holdConn = RunService.Heartbeat:Connect(function()
		hrp.CFrame = lock
		hrp.AssemblyLinearVelocity = Vector3.zero
	end)
end

local function mineUntilDone(spawn)
	holdPosition()
	local start = tick()

	while AutoFarm and spawn.Parent and tick() - start < MineTimeout do
		if #spawn:GetChildren() == 0 then break end
		equipPickaxe()
		task.wait(0.05)
		mineOnce()
		task.wait(SwingDelay)
	end

	if holdConn then holdConn:Disconnect() holdConn = nil end
end

local function getSpawns()
	local t = {}
	for _, v in ipairs(RocksFolder:GetDescendants()) do
		if v:IsA("BasePart") and v.Name == "SpawnLocation" then
			table.insert(t, v)
		end
	end
	return t
end

------------------------------------------------------------
-- Farm UI
------------------------------------------------------------
FarmTab:CreateToggle({
	Name = "Auto Farm (All Rocks)",
	CurrentValue = false,
	Callback = function(v)
		AutoFarm = v
		if not v then
			setNoclip(false)
			stopAllMotion()
			return
		end

		setNoclip(true)

		task.spawn(function()
			local idx = 1
			while AutoFarm do
				local spawns = getSpawns()
				if #spawns > 0 then
					if idx > #spawns then idx = 1 end
					local s = spawns[idx]
					moveTo(s.Position + Vector3.new(0, LandOffset, 0))
					task.wait(0.1)
					mineUntilDone(s)
					idx += 1
				end
				task.wait(0.1)
			end
		end)
	end
})

FarmTab:CreateSlider({
	Name = "Move Speed",
	Range = {25, 400},
	Increment = 5,
	CurrentValue = MoveSpeed,
	Callback = function(v) MoveSpeed = v end
})

