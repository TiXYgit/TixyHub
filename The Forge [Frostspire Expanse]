----------------------------------------------------------------
-- Shared Noclip (Farm + Player)
----------------------------------------------------------------
local noclipFarm = false
local noclipPlayer = false
local noclipConn

local function refreshNoclip()
	local enable = noclipFarm or noclipPlayer
	if enable and not noclipConn then
		noclipConn = RunService.Stepped:Connect(function()
			local char = LocalPlayer.Character
			if not char then return end
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = false end
			end
		end)
	elseif not enable and noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end
end

----------------------------------------------------------------
-- FARM SYSTEM
----------------------------------------------------------------
local Rocks = workspace:WaitForChild("Rocks")
local RedCave = Rocks:WaitForChild("Island3RedCave")

local PeakFolders = {
	Rocks:WaitForChild("Island3CavePeakEnd"),
	Rocks:WaitForChild("Island3CavePeakLeft"),
	Rocks:WaitForChild("Island3CavePeakRight"),
	Rocks:WaitForChild("Island3CavePeakStart"),
	Rocks:WaitForChild("Island3CavePeakStart01"),
}

local Knit = ReplicatedStorage:WaitForChild("Shared")
	:WaitForChild("Packages"):WaitForChild("Knit")
	:WaitForChild("Services")

local InventoryEvent = Knit.InventoryService.RE.Event
local ToolActivatedRF = Knit.ToolService.RF.ToolActivated

local AutoFarmRed = false
local AutoFarmPeak = false

local MoveSpeed = 120
local LandOffset = 1.5
local SwingDelay = 0.25
local MineTimeout = 10

local function getSpawnLocations(source)
	local t = {}
	if typeof(source) == "table" then
		for _, f in ipairs(source) do
			for _, v in ipairs(f:GetDescendants()) do
				if v:IsA("BasePart") and v.Name == "SpawnLocation" then
					table.insert(t, v)
				end
			end
		end
	else
		for _, v in ipairs(source:GetDescendants()) do
			if v:IsA("BasePart") and v.Name == "SpawnLocation" then
				table.insert(t, v)
			end
		end
	end
	return t
end

local function moveTo(pos)
	local hrp = getHRP()
	local dist = (hrp.Position - pos).Magnitude
	local time = math.clamp(dist / MoveSpeed, 0.1, 10)
	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(time, Enum.EasingStyle.Linear),
		{ CFrame = CFrame.new(pos) }
	)
	tween:Play()
	tween.Completed:Wait()
end

local function mineOnce()
	pcall(function()
		InventoryEvent:FireServer({"Pickaxe","Weapon","","","","","","","","","","Inventory"})
		ToolActivatedRF:InvokeServer("Pickaxe")
	end)
end

local function mineUntilDone(spawn)
	local start = tick()
	while spawn and spawn.Parent and tick() - start < MineTimeout do
		if not (AutoFarmRed or AutoFarmPeak) then break end
		if #spawn:GetChildren() == 0 then break end
		mineOnce()
		task.wait(SwingDelay)
	end
end

