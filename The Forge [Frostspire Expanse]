FarmTab:CreateLabel("Farm Areas")

FarmTab:CreateToggle({
	Name = "Auto Farm - Red Cave",
	Callback = function(v)
		AutoFarmRed = v
		if v then AutoFarmPeak = false end
		noclipFarm = v
		refreshNoclip()

		if v then
			task.spawn(function()
				local i = 1
				while AutoFarmRed do
					local s = getSpawnLocations(RedCave)
					if #s > 0 then
						if i > #s then i = 1 end
						moveTo(s[i].Position + Vector3.new(0, LandOffset, 0))
						mineUntilDone(s[i])
						i += 1
					end
					task.wait(0.1)
				end
			end)
		end
	end
})

FarmTab:CreateToggle({
	Name = "Auto Farm - The Peak",
	Callback = function(v)
		AutoFarmPeak = v
		if v then AutoFarmRed = false end
		noclipFarm = v
		refreshNoclip()

		if v then
			task.spawn(function()
				local i = 1
				while AutoFarmPeak do
					local s = getSpawnLocations(PeakFolders)
					if #s > 0 then
						if i > #s then i = 1 end
						moveTo(s[i].Position + Vector3.new(0, LandOffset, 0))
						mineUntilDone(s[i])
						i += 1
					end
					task.wait(0.1)
				end
			end)
		end
	end
})

