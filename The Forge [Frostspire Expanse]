})

MainTab:CreateToggle({
	Name = "Auto Farm + Auto Mine (All SpawnLocations)",
	CurrentValue = false,
	Flag = "AutoFarm",
	Callback = function(enabled)
		AutoFarmEnabled = enabled

		if not enabled then
			stopHold()
			stopMotion()
			setNoclip(false)
			notify("Farm", "Stopped safely.", 3)
			return
		end

		setNoclip(true)

		local hrp = getHRP()
		if hrp then StartCFrame = hrp.CFrame end

		task.spawn(function()
			local idx = 1
			local spawns = getSpawnLocations()
			local lastRefresh = tick()

			if #spawns == 0 then
				notify("Farm", "No SpawnLocation parts found in Island3RedCave.", 6)
			end

			while AutoFarmEnabled do
				-- refresh list every 2s in case of respawns/changes
				if tick() - lastRefresh > 2 then
					spawns = getSpawnLocations()
					lastRefresh = tick()
					if idx > #spawns then idx = 1 end
				end

				if #spawns > 0 then
					if idx > #spawns then idx = 1 end
					local spawn = spawns[idx]

					if spawn and spawn.Parent then
						-- land near the spawn (not hovering)
						local landPos = Vector3.new(
							spawn.Position.X,
							spawn.Position.Y + LandOffset,
							spawn.Position.Z
						)

						moveTo(landPos)
						task.wait(0.05)

						-- mine until done
						mineUntilDone(spawn)
					end

					idx += 1
				end

				task.wait(0.1)
			end
		end)
	end,
})

