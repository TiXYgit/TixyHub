MiscTab:CreateLabel("ESP")

local ESPPlayers = false
local ESPRocks = false
local PlayerESP = {}
local RockESP = {}

local function clear(tbl)
	for _, v in pairs(tbl) do pcall(function() v:Destroy() end) end
	table.clear(tbl)
end

local function refreshPlayerESP()
	clear(PlayerESP)
	if not ESPPlayers then return end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local hl = Instance.new("Highlight", workspace)
			hl.Adornee = p.Character
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			PlayerESP[p] = hl
		end
	end
end

local function refreshRockESP()
	clear(RockESP)
	if not ESPRocks then return end
	for _, s in ipairs(getSpawnLocations(RedCave)) do
		local hl = Instance.new("Highlight", workspace)
		hl.Adornee = s
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		RockESP[s] = hl
	end
end

MiscTab:CreateToggle({
	Name = "ESP Players",
	Callback = function(v) ESPPlayers = v refreshPlayerESP() end
})

MiscTab:CreateToggle({
	Name = "ESP Rocks",
	Callback = function(v) ESPRocks = v refreshRockESP() end
})

MiscTab:CreateLabel("Teleport")

local Selected = ""

local Dropdown = MiscTab:CreateDropdown({
