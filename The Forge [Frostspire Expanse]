	:WaitForChild("Packages"):WaitForChild("Knit")
	:WaitForChild("Services")

local InventoryEvent = KnitRoot.InventoryService.RE.Event
local ToolActivatedRF = KnitRoot.ToolService.RF.ToolActivated

------------------------------------------------------------
-- Variables
------------------------------------------------------------
local AutoFarmEnabled = false
local MoveSpeed = 120
local LandOffset = 1.5          -- stand near rock instead of hovering
local SwingDelay = 0.25         -- delay between mining swings
local MineTimeout = 10          -- max seconds per rock (safety)
local StartCFrame

local activeTween, applyConn, cfValue, holdConn, noclipConn

------------------------------------------------------------
-- Utility
------------------------------------------------------------
local function notify(title, content, dur)
	Rayfield:Notify({ Title = title, Content = content, Duration = dur or 3 })
end

local function getChar()
	return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHRP()
	local c = getChar()
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
	local c = getChar()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function setNoclip(on)
	if on then
		if noclipConn then noclipConn:Disconnect() end
		noclipConn = RunService.Stepped:Connect(function()
			local c = LocalPlayer.Character
			if not c then return end
			for _, p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = false end
			end
		end)
	else
		if noclipConn then noclipConn:Disconnect() noclipConn = nil end
		local c = LocalPlayer.Character
		if c then
			for _, p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = true end
			end
		end
	end
end

local function stopMotion()
	if applyConn then applyConn:Disconnect() applyConn = nil end
	if activeTween then pcall(function() activeTween:Cancel() end) activeTween = nil end
	if cfValue then pcall(function() cfValue:Destroy() end) cfValue = nil end
	if holdConn then holdConn:Disconnect() holdConn = nil end

	local hrp = getHRP()
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end

	local hum = getHum()
	if hum then
		pcall(function() hum.PlatformStand = false end)
		pcall(function() hum.AutoRotate = true end)
	end
end

------------------------------------------------------------
-- Movement
------------------------------------------------------------
local function moveTo(pos)
	local hrp = getHRP()
	if not hrp then return false end

	stopMotion()

	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero

	cfValue = Instance.new("CFrameValue")
	cfValue.Value = hrp.CFrame

	applyConn = RunService.Heartbeat:Connect(function()
		if hrp and cfValue then hrp.CFrame = cfValue.Value end
	end)

	local dist = (hrp.Position - pos).Magnitude
	local duration = math.clamp(dist / math.max(MoveSpeed, 1), 0.08, 12)

	activeTween = TweenService:Create(
		cfValue,
		TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{ Value = CFrame.new(pos) }
	)

	activeTween:Play()
	activeTween.Completed:Wait()

	-- stop tween apply, keep stable
	if applyConn then applyConn:Disconnect() applyConn = nil end
	if cfValue then cfValue:Destroy() cfValue = nil end
	activeTween = nil

	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	return true
end

-- Hold player in place while mining (prevents falling with noclip ON)
local function startHold()
	local hrp = getHRP()
	if not hrp then return end

	if holdConn then holdConn:Disconnect() end
	local locked = hrp.CFrame

	holdConn = RunService.Heartbeat:Connect(function()
		if hrp then
			hrp.CFrame = locked
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end)
end

local function stopHold()
	if holdConn then holdConn:Disconnect() holdConn = nil end
end

------------------------------------------------------------
-- Tool / Mining
------------------------------------------------------------
local function equipPickaxe()
	local args = {{
		"Pickaxe",
		"Weapon",
		"AttackDamagePotion1",
		"PortalTool",
		"FungisMushroom",
		"",
		"LuckPotion1",
		"SimpleLantern",
		"MinerPotion1",
		"",
		"",
		"Inventory"
	}}
	pcall(function()
		InventoryEvent:FireServer(unpack(args))
	end)
end

local function mineOnce()
	pcall(function()
		ToolActivatedRF:InvokeServer("Pickaxe")
	end)
end

-- ✅ Mine repeatedly until rock finishes (spawn children empty) or timeout
local function mineUntilDone(spawn)
	if not spawn or not spawn.Parent then return end

	startHold()

	local start = tick()
	while AutoFarmEnabled and spawn and spawn.Parent and (tick() - start) < MineTimeout do
		-- if rock is gone / finished
		if #spawn:GetChildren() == 0 then
			break
		end

		equipPickaxe()
		task.wait(0.05)

		mineOnce()
		task.wait(SwingDelay)
	end

	stopHold()
end

------------------------------------------------------------
-- Farm Targets
------------------------------------------------------------
local function getSpawnLocations()
	local list = {}
	for _, obj in ipairs(RocksFolder:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "SpawnLocation" then
			table.insert(list, obj)
		end
	end
	return list
end

